# Obtenha o token em https://brapi.dev/dashboard e mantenha-o apenas localmente.
BRAPI_TOKEN=

# Tickers separados por vírgula. Eles podem ser sobrescritos no comando de coleta.
TICKERS=B3SA3

# Conta de serviço do Google Cloud com a Google Drive API habilitada.
# Compartilhe o arquivo .xlsx do Drive com o e-mail dessa conta como Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_DRIVE_FILE_ID=
GOOGLE_DRIVE_WORKSHEET=historico

# Configuração do dashboard (o token BRAPI nunca é enviado ao navegador).
DASH_HOST=127.0.0.1
DASH_PORT=8050
